# Local dev only: the Vite dev server proxies /api to API Gateway,
# injecting the key automatically. Copy to .env (never commit a filled-in key).
API_BASE_URL=https://your-api-id.execute-api.ap-south-1.amazonaws.com/v1
API_KEY=your-api-key-here

# Production: the frontend calls same-origin /api and the Cloudflare Worker
# (frontend/worker.js) injects the key from its API_KEY secret, so no
# build-time variables are needed. Set the secret with:
#   npx wrangler secret put API_KEY
#
# The VITE_ variables below are optional overrides that bypass the proxy
# and call API Gateway directly from the browser bundle. Leave them unset
# unless you know you need direct access.
# VITE_API_URL=https://your-api-id.execute-api.ap-south-1.amazonaws.com/v1
# VITE_API_KEY=your-api-key-here
